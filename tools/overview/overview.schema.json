{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A7E7-Studios/faster-spec/blob/main/tools/overview/overview.schema.json",
  "title": "Overview index",
  "description": "The solution across repositories: features (capabilities) with their review state, Looks, scenarios and tests, the systems they ship in, the change folders, and the components. Written by tools/overview/overview.mjs; version 3.",
  "type": "object",
  "required": ["version", "generatedAt", "assetsDir", "repos", "domains", "systems", "capabilities", "changes", "components", "outside", "uncovered", "totals"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 3 },
    "generatedAt": { "type": "string", "format": "date-time", "description": "When the index was written (UTC)." },
    "assetsDir": { "type": ["string", "null"], "description": "The --assets folder every asset path is relative to; null without --assets." },
    "repos": { "type": "array", "items": { "$ref": "#/$defs/repo" } },
    "domains": { "type": "array", "items": { "$ref": "#/$defs/domain" }, "description": "specs/domains.json of the first repository that has one, then any other ids the others add." },
    "systems": { "type": "array", "items": { "$ref": "#/$defs/system" }, "description": "Every repository's specs/systems.json, merged by id; in the order first declared." },
    "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "description": "The features, in domain order, then by id. A feature present in several repositories is one entry with a side per repository." },
    "changes": { "type": "array", "items": { "$ref": "#/$defs/change" }, "description": "Every changes/<id>/ at the read refs, by id. One entry per id across repositories." },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "outside": { "$ref": "#/$defs/outside" },
    "uncovered": { "type": "array", "items": { "$ref": "#/$defs/uncovered" }, "description": "Components inside a system that no spec's code path is at, under or above." },
    "totals": { "$ref": "#/$defs/totals" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "capabilityId": { "type": "string", "pattern": "^[^/]+/[^/]+$", "description": "<domain>/<capability>" },
    "repoId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "strings": { "type": "array", "items": { "type": "string" } },
    "review": { "enum": ["unreviewed", "approved", "changes-requested"] },
    "commitStamp": {
      "type": ["object", "null"],
      "required": ["commit", "date", "pr"],
      "additionalProperties": false,
      "properties": {
        "commit": { "$ref": "#/$defs/sha" },
        "date": { "type": "string", "format": "date-time", "description": "The commit's committer date." },
        "pr": { "type": ["integer", "null"], "description": "From a commit subject ending (#<n>)." }
      }
    },
    "repoPath": {
      "type": "object",
      "required": ["repo", "path"],
      "additionalProperties": false,
      "properties": {
        "repo": { "$ref": "#/$defs/repoId" },
        "path": { "type": "string" }
      }
    },
    "repo": {
      "type": "object",
      "required": ["id", "name", "ref", "commit"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/repoId" },
        "name": { "type": "string", "description": "owner/name from the origin URL, else the folder's name." },
        "ref": { "type": "string" },
        "commit": { "$ref": "#/$defs/sha" }
      }
    },
    "domain": {
      "type": "object",
      "required": ["id", "title", "purpose"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "purpose": { "type": "string" }
      }
    },
    "system": {
      "type": "object",
      "required": ["id", "title", "purpose", "sides", "capabilities", "components"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "description": "From the first repository given that declares the system." },
        "purpose": { "type": "string", "description": "From the first repository given that declares the system." },
        "sides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repo", "paths"],
            "additionalProperties": false,
            "properties": {
              "repo": { "$ref": "#/$defs/repoId" },
              "paths": { "$ref": "#/$defs/strings", "description": "The paths this repository declares for the system; a folder ends with /." }
            }
          }
        },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capabilityId" }, "description": "The features with a code path in this system, sorted." },
        "components": { "type": "array", "items": { "$ref": "#/$defs/repoPath" }, "description": "The components whose folder lies in this system." }
      }
    },
    "capability": {
      "type": "object",
      "required": ["id", "domain", "title", "summary", "review", "reviewed", "systems", "sides", "looks", "requirements", "pendingChanges"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "domain": { "type": "string" },
        "title": { "type": "string", "description": "From the first repository given that has the feature." },
        "summary": { "type": "string", "description": "The spec's ## Summary, inline Markdown kept; from the first repository given." },
        "review": { "$ref": "#/$defs/review", "description": "changes-requested if any side says so; else unreviewed if any side is unreviewed or its review does not read; else approved." },
        "reviewed": { "$ref": "#/$defs/commitStamp", "description": "The newest of the sides' reviewed." },
        "systems": { "type": "array", "items": { "$ref": "#/$defs/id" }, "description": "Every side's systems, sorted." },
        "sides": { "type": "array", "items": { "$ref": "#/$defs/capabilitySide" } },
        "looks": { "type": "array", "items": { "$ref": "#/$defs/look" }, "description": "Every side's well-formed Looks lines, in order." },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" }, "description": "Every side's requirements, each tagged with its repository." },
        "pendingChanges": { "type": "array", "items": { "type": "string" }, "description": "Ids of the change folders whose proposal names this feature in capabilities." }
      }
    },
    "capabilitySide": {
      "type": "object",
      "required": ["repo", "spec", "review", "reviewed", "code", "systems", "components", "problems"],
      "additionalProperties": false,
      "properties": {
        "repo": { "$ref": "#/$defs/repoId" },
        "spec": { "type": "string", "description": "specs/<domain>/<capability>/spec.md" },
        "review": { "anyOf": [{ "$ref": "#/$defs/review" }, { "type": "null" }], "description": "The spec's review; null when it is missing or not one of the three." },
        "reviewed": { "$ref": "#/$defs/commitStamp", "description": "The newest first-parent commit on the ref that added or removed the spec's review: line (the one that last set it); null when none did." },
        "code": { "$ref": "#/$defs/strings", "description": "The spec's code paths; a folder ends with /." },
        "systems": { "type": "array", "items": { "$ref": "#/$defs/id" }, "description": "The systems the code paths fall in, sorted: each path's nearest system declaring it or a folder above it." },
        "components": { "$ref": "#/$defs/strings", "description": "The folder of the nearest (deepest) component up each code path." },
        "problems": {
          "type": "array",
          "description": "Each break of the spec format; empty for a spec the gate passes.",
          "items": {
            "type": "object",
            "required": ["line", "message"],
            "additionalProperties": false,
            "properties": {
              "line": { "type": "integer", "minimum": 1 },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "look": {
      "oneOf": [
        {
          "type": "object",
          "required": ["repo", "kind", "path", "id", "caption", "exists", "asset"],
          "additionalProperties": false,
          "properties": {
            "repo": { "$ref": "#/$defs/repoId" },
            "kind": { "const": "board" },
            "path": { "type": "string", "description": "specs/<domain>/<capability>/looks/<name>.html" },
            "id": { "type": "string", "description": "The board section's id." },
            "caption": { "type": "string" },
            "exists": { "type": "boolean", "description": "The board file exists at the read ref." },
            "asset": { "type": ["string", "null"], "description": "<repo-id>/<path> under assetsDir; null without --assets or when the board does not exist." }
          }
        },
        {
          "type": "object",
          "required": ["repo", "kind", "target", "caption"],
          "additionalProperties": false,
          "properties": {
            "repo": { "$ref": "#/$defs/repoId" },
            "kind": { "const": "page" },
            "target": { "type": "string", "description": "A path in the app, or a URL." },
            "caption": { "type": "string" }
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "required": ["repo", "name", "text", "scenarios"],
      "additionalProperties": false,
      "properties": {
        "repo": { "$ref": "#/$defs/repoId" },
        "name": { "type": "string" },
        "text": { "type": "string", "description": "The requirement's statement, inline Markdown kept." },
        "scenarios": { "type": "array", "items": { "$ref": "#/$defs/scenario" } }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["name", "slug", "text", "table", "proofs", "tested"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "text": { "type": "string", "description": "One line per step (\"GIVEN …\", \"WHEN …\", \"THEN …\", \"AND …\"), then one line per table row (\"| a | b |\")." },
        "table": {
          "type": ["object", "null"],
          "required": ["header", "rows"],
          "additionalProperties": false,
          "properties": {
            "header": { "$ref": "#/$defs/strings" },
            "rows": { "type": "array", "items": { "$ref": "#/$defs/strings" } }
          }
        },
        "proofs": { "type": "array", "items": { "$ref": "#/$defs/proof" } },
        "tested": { "type": "boolean", "description": "It has at least one well-formed test: line." }
      }
    },
    "proof": {
      "oneOf": [
        {
          "type": "object",
          "required": ["check", "state", "path", "exists"],
          "additionalProperties": false,
          "properties": {
            "check": { "const": "test" },
            "state": { "const": "test" },
            "path": { "type": "string", "description": "The test's repository path." },
            "selector": { "type": "string", "description": "What follows ::" },
            "exists": { "type": "boolean", "description": "The path exists at the read ref." }
          }
        },
        {
          "type": "object",
          "required": ["check", "state", "error"],
          "additionalProperties": false,
          "properties": {
            "check": { "type": "string", "description": "The word before the colon (test, or another a scenario does not take); unknown for an unreadable line." },
            "state": { "const": "invalid" },
            "path": { "type": "string" },
            "error": { "type": "string", "description": "Why the line breaks the format." }
          }
        }
      ]
    },
    "change": {
      "type": "object",
      "required": ["id", "title", "sides"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "description": "From the first repository given whose proposal.md has one; the id otherwise." },
        "sides": { "type": "array", "items": { "$ref": "#/$defs/changeSide" } }
      }
    },
    "changeSide": {
      "type": "object",
      "required": ["repo", "path", "capabilities", "removes", "review", "files", "landed"],
      "additionalProperties": false,
      "properties": {
        "repo": { "$ref": "#/$defs/repoId" },
        "path": { "type": "string", "description": "changes/<id>" },
        "capabilities": { "$ref": "#/$defs/strings" },
        "removes": { "$ref": "#/$defs/strings", "description": "Capability ids this change deletes." },
        "review": { "type": ["string", "null"], "description": "The proposal's ## Review section as plain text, paragraphs joined by a blank line; null when proposal.md or the section is absent." },
        "files": { "$ref": "#/$defs/strings" },
        "landed": { "$ref": "#/$defs/commitStamp", "description": "The newest first-parent commit on the ref that added proposal.md; null when there is no proposal.md." }
      }
    },
    "component": {
      "type": "object",
      "description": "A folder holding a file a component marker matches (overview.componentMarkers; README.md, package.json, pyproject.toml, build.gradle, build.gradle.kts, a non-test *.asmdef when the config names none), never under node_modules.",
      "required": ["repo", "path", "system", "readme", "assembly", "package", "manifest", "title", "summary", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "repo": { "$ref": "#/$defs/repoId" },
        "path": { "type": "string", "description": "The folder; . for the root." },
        "system": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }], "description": "The nearest system declaring the folder or one above it; null for none (always for the root)." },
        "readme": { "type": ["string", "null"], "description": "The folder's README.md, or null." },
        "assembly": { "type": ["string", "null"], "description": "The name of the folder's non-test *.asmdef, or null." },
        "package": { "type": ["string", "null"], "description": "The package name its manifest gives (package.json name, pyproject.toml [project] or [tool.poetry] name), or null." },
        "manifest": { "type": ["string", "null"], "description": "The folder's first marker file other than README.md and *.asmdef, in marker order, or null." },
        "title": { "type": "string", "description": "The README's first heading, else the assembly's name, else the package's name, else the folder's name." },
        "summary": { "type": "string", "maxLength": 300, "description": "The README's first paragraph as plain text, else the manifest's description, else empty." },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capabilityId" }, "description": "Features with a code path whose nearest (deepest) component up its tree is this one, sorted." }
      }
    },
    "outside": {
      "type": "object",
      "description": "Code outside every system, only for repositories that declare at least one system.",
      "required": ["components", "code"],
      "additionalProperties": false,
      "properties": {
        "components": { "type": "array", "items": { "$ref": "#/$defs/repoPath" }, "description": "Components in no system and holding no system's path." },
        "code": {
          "type": "array",
          "description": "Spec code paths in no system.",
          "items": {
            "type": "object",
            "required": ["repo", "capability", "path"],
            "additionalProperties": false,
            "properties": {
              "repo": { "$ref": "#/$defs/repoId" },
              "capability": { "$ref": "#/$defs/capabilityId" },
              "path": { "type": "string" }
            }
          }
        }
      }
    },
    "uncovered": {
      "type": "object",
      "required": ["repo", "system", "path"],
      "additionalProperties": false,
      "properties": {
        "repo": { "$ref": "#/$defs/repoId" },
        "system": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "description": "The component's folder." }
      }
    },
    "count": { "type": "integer", "minimum": 0 },
    "totals": {
      "type": "object",
      "required": ["repos", "domains", "systems", "components", "capabilities", "scenarios", "changes"],
      "additionalProperties": false,
      "properties": {
        "repos": { "$ref": "#/$defs/count" },
        "domains": { "$ref": "#/$defs/count" },
        "systems": { "$ref": "#/$defs/count" },
        "components": { "$ref": "#/$defs/count" },
        "capabilities": {
          "type": "object",
          "required": ["total", "unreviewed", "approved", "changesRequested"],
          "additionalProperties": false,
          "properties": {
            "total": { "$ref": "#/$defs/count" },
            "unreviewed": { "$ref": "#/$defs/count" },
            "approved": { "$ref": "#/$defs/count" },
            "changesRequested": { "$ref": "#/$defs/count" }
          }
        },
        "scenarios": {
          "type": "object",
          "required": ["total", "tested", "untested"],
          "additionalProperties": false,
          "properties": {
            "total": { "$ref": "#/$defs/count" },
            "tested": { "$ref": "#/$defs/count" },
            "untested": { "$ref": "#/$defs/count" }
          }
        },
        "changes": {
          "type": "object",
          "required": ["total"],
          "additionalProperties": false,
          "properties": {
            "total": { "$ref": "#/$defs/count" }
          }
        }
      }
    }
  }
}
